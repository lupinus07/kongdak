# 이 파일을 .env.local로 복사해서 값을 채우세요. 실제 키는 .env.local에만 두고 커밋하지 않습니다.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 — NEXT_PUBLIC_ 접두어 절대 금지
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# 토스페이먼츠 결제위젯 클라이언트 키 (공개 가능)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 카카오톡 공유(내 카톡으로 보내기) — 카카오 개발자 센터 > 앱 키 > JavaScript 키 (공개 가능)
# [플랫폼 > Web]에 사이트 도메인(http://localhost:3000, 배포 도메인)도 등록해야 합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
